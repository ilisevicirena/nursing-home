# Copy this file to .env and fill in the real values.
# .env is git-ignored and should never be committed.

DB_SERVER=YOUR_SQL_SERVER_NAME
DB_NAME=YOUR_DATABASE_NAME
DB_AUTH_TYPE=ntlm
DB_USERNAME=your_windows_username
DB_PASSWORD=your_windows_password
DB_DOMAIN=YOUR_DOMAIN

JWT_SECRET=replace_with_a_strong_random_secret

OUTLOOK_EMAIL=your-email@outlook.com
OUTLOOK_PASSWORD=your-outlook-password
